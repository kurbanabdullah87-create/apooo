# Client-visible Supabase project settings. The publishable/anon key is not a service-role secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only settings. Never prefix these with VITE_ and never expose them in client code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only FXAPI key. Without it the app uses daily Frankfurter reference rates.
FXAPI_API_KEY=
# Only used if FXAPI reports a custom/unknown plan; known plans follow provider limits.
FXAPI_UPDATE_INTERVAL_SECONDS=

# Optional cron authentication secrets, server only.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# iyzico Checkout Form — server-only; never prefix these with VITE_.
# Start with sandbox credentials while testing. Live charges require an approved merchant account.
IYZICO_ENV=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
APP_BASE_URL=https://your-production-domain.example
